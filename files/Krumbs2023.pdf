      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Herbivorous Fish Microbiome Adaptations to Sulfated Dietary Polysaccharides</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/aem.02154-22</rdf:li>
        </rdf:Alt>
      </dc:identifier>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Sheila Podell</rdf:li>
          <rdf:li>Aaron Oliver</rdf:li>
          <rdf:li>Linda Wegley Kelly</rdf:li>
          <rdf:li>Wesley J. Sparagon</rdf:li>
          <rdf:li>Alvaro M. Plominsky</rdf:li>
          <rdf:li>Robert S. Nelson</rdf:li>
          <rdf:li>Lieve M. L. Laurens</rdf:li>
          <rdf:li>Simona Augyte</rdf:li>
          <rdf:li>Neil A. Sims</rdf:li>
          <rdf:li>Craig E. Nelson</rdf:li>
          <rdf:li>Eric E. Allen</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Environmental Microbiology</rdf:li>
          <rdf:li xml:lang="x-repair">Environmental Microbiology</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>fish gut microbiome</rdf:li>
          <rdf:li>polysaccharide utilization</rdf:li>
          <rdf:li>sulfatase</rdf:li>
          <rdf:li>macroalgal digestion</rdf:li>
          <rdf:li>kyphosid</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li xml:lang="x-default">American Society for Microbiology</rdf:li>
        </rdf:Bag>
      </dc:publisher>
